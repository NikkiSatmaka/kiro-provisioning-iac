# OPTIONAL — you normally do NOT need this file.
#
# Every variable below has a working default, so `mise run backend-bootstrap`
# runs with NO terraform.tfvars: the bucket name is derived from your account
# id and region/profile come from the git-ignored .env (via mise). Only create
# this file to OVERRIDE a default:
#
#   cp terraform.tfvars.example terraform.tfvars   # then uncomment what you override
#
# terraform.tfvars is git-ignored.

# Region/profile usually come from the environment (mise sources them from the
# git-ignored .env). Leave aws_region empty to inherit AWS_REGION.
# Uncomment to pin instead. Keep region the SAME as the main config.
# aws_region  = "us-east-1"
# aws_profile = "kiro-provisioning"

# OPTIONAL: the state bucket name. Leave this commented out and the bootstrap
# derives a deterministic, globally-unique name from your account id:
#   kiro-tofu-state-<ACCOUNT_ID>
# Uncomment and set a value ONLY to override that (must stay globally unique).
# state_bucket_name = "acme-kiro-tofu-state-123456789012"

# Lock table name (unique within the account/region is enough).
lock_table_name = "kiro-tofu-locks"

# Leave false normally. Set true ONLY when you intend to destroy the backend
# and are OK deleting all stored state versions.
force_destroy = false
