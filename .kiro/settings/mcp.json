{
  "mcpServers": {
    "aws-mcp": {
      "command": "mise",
      "args": [
        "exec",
        "--",
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "env": {},
      "timeout": 100000,
      "transport": "stdio",
      "disabled": false,
      "autoApprove": []
    }
  }
}
