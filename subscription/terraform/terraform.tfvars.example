# Copy to terraform.tfvars and edit per project. terraform.tfvars is git-ignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# ---- Instance mode: organization (default) OR account -----------------------
# This stack supports two IdC instance modes:
#
#   instance_mode = "organization"  (default; today's behavior)
#     Writes into the AWS Organizations MANAGEMENT account's ORGANIZATION
#     instance. AWS_PROFILE must be a management-account profile. Per-group
#     account assignments ARE available (enable_account_access may be true).
#
#   instance_mode = "account"
#     Writes into a CHILD/member account's OWN IdC ACCOUNT INSTANCE. AWS_PROFILE
#     must be that CHILD account's profile, and idc_instance_arn /
#     identity_store_id must point at the child's instance. Only users, groups,
#     and memberships are created — account assignments are NOT available on an
#     account instance, so enable_account_access MUST be false (a precondition
#     fails the plan otherwise). See the account-mode block at the bottom.
#
# Leave this unset to get the default "organization" mode.
# instance_mode = "organization"

# ---- Provider / environment -------------------------------------------------
# In organization mode this stack targets the AWS Organizations MANAGEMENT
# account (AWS_PROFILE must be a management-account profile); in account mode it
# targets the child account (AWS_PROFILE must be the child account's profile).
# Usually left to the environment (mise sources AWS_PROFILE / AWS_REGION from the
# git-ignored .env). Leave aws_region empty to inherit AWS_REGION. Uncomment to
# pin explicitly instead.
# aws_region  = "us-east-1"
# aws_profile = "kiro-mgmt"

# ---- Foundation IdC interface (consumed, never created) ---------------------
# Export these from the foundation stack (tofu output). In organization mode
# they point at the management account's ORGANIZATION instance; in account mode
# (run foundation under the child account's profile) they point at the child
# account's OWN account instance.
# idc_instance_arn  = "arn:aws:sso:::instance/ssoins-xxxxxxxxxxxx"
# identity_store_id = "d-xxxxxxxxxx"

# ---- Workshop namespace -----------------------------------------------------
# workshop_id is NOT set here: it comes from the environment (WORKSHOP_ID in
# .env via TF_VAR_workshop_id, exported by the provision/teardown mise tasks),
# which is the single source of truth and overrides any tfvars value — so it is
# intentionally not assigned here.

# ---- Account-access gate ----------------------------------------------------
# false (default) => create NO permission sets and NO account assignments:
# workshop users are Kiro-login-only with ZERO AWS console access. Flip to true
# ONLY when deliberately granting console access (binds each group to its
# owning account id below).
enable_account_access = false

# ---- Workshop accounts (billing attribution; NOT an access grant) -----------
# Nested map: 12-digit account id => { groups = { <group> => { user_count } } }.
# The account id is billing/attribution metadata only — it is the assignment
# target used ONLY when enable_account_access = true. With the flag false (the
# default) these ids grant no console access whatsoever.
workshop_accounts = {
  "111122223333" = {
    groups = {
      "team-a" = { user_count = 10 }
    }
  }
}

# ---- Kiro tier --------------------------------------------------------------
#   PRO | PRO_PLUS | PRO_MAX | POWER
# NOTE: tier is applied to groups by the console/scripts, not by OpenTofu.
kiro_tier = "PRO"

# ---- Tags -------------------------------------------------------------------
# workshop_id is merged into default_tags UNCONDITIONALLY by the provider, so it
# does not need to be listed here.
default_tags = {
  Project   = "kiro-provisioning-iac"
  ManagedBy = "opentofu"
  Purpose   = "kiro-login-only"
}

# =============================================================================
# ---- ACCOUNT MODE (child-account IdC account instance) — alternative ---------
# =============================================================================
# To provision against a CHILD/member account's OWN IdC account instance instead
# of the organization instance, swap the block above for the account-mode shape
# below. The workshop_accounts SHAPE is identical; the account-id key is only
# naming/namespacing metadata in this mode (never an assignment target).
#
#   instance_mode         = "account"
#   enable_account_access = false   # REQUIRED in account mode — account
#                                   # instances do not support permission sets
#                                   # or account assignments. A precondition
#                                   # fails the plan if this is true here.
#
# Operator checklist for account mode (see subscription/README.md + RUNBOOK.md):
#   - Enable IAM Identity Center IN THE CHILD ACCOUNT first (creates its account
#     instance). This is the per-account equivalent of the org-mode Step 0.
#   - Run with the CHILD ACCOUNT's AWS_PROFILE, and point idc_instance_arn /
#     identity_store_id at the child's instance (foundation, run under the child
#     profile, resolves them). CAUTION (R-2): running with a MANAGEMENT-account
#     profile while intending account mode silently writes to the ORGANIZATION
#     instance — double-check the profile.
#   - Known limitation (OQ-1): AWS supports Kiro on account instances UNLESS
#     users need the full set of Kiro features on AWS websites. For login-only
#     workshops the impact is minimal; verify against a real child-account
#     instance before a production workshop.
