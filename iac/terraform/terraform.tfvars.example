# Copy to terraform.tfvars and edit per project. terraform.tfvars is git-ignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# ---- Provider / environment -------------------------------------------------
# Usually left to the environment (mise sources AWS_PROFILE / AWS_REGION from
# the git-ignored .env). Leave aws_region empty to inherit AWS_REGION.
# Uncomment to pin explicitly instead.
# aws_region  = "us-east-1"
# aws_profile = "kiro-provisioning"

instance_name = "kiro-login"

# ---- Naming -----------------------------------------------------------------
user_prefix      = "kiro-user-"
group_prefix     = "kiro-team-"
sequence_padding = 2   # => 01, 02, ...
sequence_start   = 1

# ---- Counts -----------------------------------------------------------------
user_count  = 10
group_count = 1

# ---- User attributes --------------------------------------------------------
# Users are provisioned anonymously (username only) by default.
#
# Email is OPTIONAL and supplemental: set an address only for the users that
# need one, keyed by the same padded sequence as the username ("01", "02", ...).
# Keys must fall within user_count. Any user not listed stays anonymous.
# Leave user_emails unset (empty) for the all-anonymous OTP flow.
# user_emails = {
#   "01" = "alice@corp.com"
#   "03" = "carol@corp.com"
# }
display_name_template = "Kiro User {seq}"

# ---- Membership strategy ----------------------------------------------------
#   all_in_first | round_robin | none
membership_strategy = "all_in_first"

# ---- Kiro tier --------------------------------------------------------------
#   PRO | PRO_PLUS | PRO_MAX | POWER
# NOTE: tier is applied to groups by the console/scripts, not by OpenTofu.
kiro_tier = "PRO"

# ---- Tags -------------------------------------------------------------------
default_tags = {
  Project   = "kiro-subscriptions"
  ManagedBy = "opentofu"
  Purpose   = "kiro-login-only"
}
