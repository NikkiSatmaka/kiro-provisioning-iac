# Copy to terraform.tfvars and edit per project. terraform.tfvars is git-ignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# ---- Provider / environment -------------------------------------------------
# This stack targets the AWS Organizations MANAGEMENT account. AWS_PROFILE must
# be a management-account profile. Usually left to the environment (mise sources
# AWS_PROFILE / AWS_REGION from the git-ignored .env). Leave aws_region empty to
# inherit AWS_REGION. Uncomment to pin explicitly instead.
# aws_region  = "us-east-1"
# aws_profile = "kiro-mgmt"

# ---- Foundation IdC interface (consumed, never created) ---------------------
# Export these from the foundation stack (tofu output). They point at the
# management account's existing ORGANIZATION IdC instance.
# idc_instance_arn  = "arn:aws:sso:::instance/ssoins-xxxxxxxxxxxx"
# identity_store_id = "d-xxxxxxxxxx"

# ---- Workshop namespace -----------------------------------------------------
# Namespaces this workshop's state key, usernames, and group display names so
# many workshops coexist in the one management-account org IdC directory.
workshop_id = "kiro-2025-10-10"

# ---- Account-access gate ----------------------------------------------------
# false (default) => create NO permission sets and NO account assignments:
# workshop users are Kiro-login-only with ZERO AWS console access. Flip to true
# ONLY when deliberately granting console access (binds each group to its
# owning account id below).
enable_account_access = false

# ---- Workshop accounts (billing attribution; NOT an access grant) -----------
# Nested map: 12-digit account id => { groups = { <group> => { user_count } } }.
# The account id is billing/attribution metadata only — it is the assignment
# target used ONLY when enable_account_access = true. With the flag false (the
# default) these ids grant no console access whatsoever.
workshop_accounts = {
  "111122223333" = {
    groups = {
      "team-a" = { user_count = 10 }
    }
  }
}

# ---- Kiro tier --------------------------------------------------------------
#   PRO | PRO_PLUS | PRO_MAX | POWER
# NOTE: tier is applied to groups by the console/scripts, not by OpenTofu.
kiro_tier = "PRO"

# ---- Tags -------------------------------------------------------------------
# workshop_id is merged into default_tags UNCONDITIONALLY by the provider, so it
# does not need to be listed here.
default_tags = {
  Project   = "kiro-subscriptions"
  ManagedBy = "opentofu"
  Purpose   = "kiro-login-only"
}
