# ===========================================================================
# Remote state backend (Option B — the PRIMARY teardown path)   OPT-IN
# ===========================================================================
#
# This file is named `backend.tf.example` so it is INERT by default — OpenTofu
# only reads files ending in `.tf`. The repo therefore runs out of the box with
# LOCAL state. To switch to remote state, rename this file:
#
#   mv backend.tf.example backend.tf
#
# WHY REMOTE STATE MATTERS FOR TEARDOWN
# -------------------------------------
# `tofu destroy` can only delete what is in its STATE. With local state (the
# default) state lives in this directory and is git-ignored, so it does NOT
# travel with the repo. On a fresh clone (different machine, a month later) a
# local backend has empty state and `tofu destroy` would delete NOTHING,
# orphaning every user, group, and the account instance.
#
# With this S3 backend, state lives in S3. `tofu init` on ANY machine with
# credentials pulls the real state, and `tofu destroy` works. This is the
# reliable "a month later, different computer" path.
#
# SETUP (one time)
# ----------------
#   1. Create the bucket + lock table (see ./backend-bootstrap/):
#        cd backend-bootstrap
#        cp terraform.tfvars.example terraform.tfvars   # unique bucket name
#        tofu init && tofu apply
#        tofu output backend_hcl        # copy the printed block
#   2. Back here:
#        mv backend.tf.example backend.tf
#        cp backend.hcl.example backend.hcl             # paste the block
#        tofu init -backend-config=backend.hcl          # answer "yes" to migrate
#
# The `backend "s3" {}` block is left EMPTY on purpose (partial configuration):
# the account-specific values come from the git-ignored backend.hcl so this file
# stays reusable across accounts and carries no secrets.

terraform {
  backend "s3" {}
}
