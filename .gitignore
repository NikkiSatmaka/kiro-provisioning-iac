# Raw credentials provided for setup — never commit
creds/

# Project-local AWS credentials (contains secret access key)
.aws/credentials

# mise local/secret overrides
mise.local.toml
.mise.local.toml

# Per-run / per-account settings sourced by mise. The template (.env.example)
# stays tracked; the real .env is local-only.
.env
!.env.example

# Python project virtualenv (managed by mise/uv; recreated via `mise install`)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# OpenTofu/Terraform local working dir (provider plugin cache; recreated by init)
.terraform/

# Git worktrees for AI-assisted / parallel development live here. The worktree
# directories are backed by the shared .git store and must never be committed.
.worktrees/

# Credential Claim Service local-only artifacts. The audit CSVs contain claimed
# emails (PII) and the backend.hcl holds the per-account state config; the
# tracked backend.hcl.example stays tracked.
claim-service/output/
claim-service/terraform/backend.hcl
