# ---- Generated credentials / secrets (NEVER commit) ----
# The rendered credentials file and any collected one-time passwords.
output/credentials.md
output/manifest.json
output/*.csv
output/otps.csv
# Keep the directory and the template/placeholder tracked.
!output/.gitkeep
!output/credentials.template.md

# ---- Local, per-project config ----
config/settings.env
terraform/terraform.tfvars
terraform/*.auto.tfvars

# ---- Remote backend wiring ----
# backend.tf is TRACKED and value-free (the partial `backend "s3" {}` block);
# it is NOT ignored. backend.hcl names your account's state bucket and is
# account-specific — it is auto-written by `mise run backend-bootstrap` (or
# copied from the tracked backend.hcl.example template), so it stays ignored.
terraform/backend.hcl

# ---- OpenTofu / Terraform state & working dirs ----
# State can contain user/group IDs — treat as sensitive. (No passwords are ever
# in state.)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json
# Keep the dependency lock file tracked (reproducible provider versions).
!terraform/.terraform.lock.hcl

# ---- Python ----
__pycache__/
*.pyc
