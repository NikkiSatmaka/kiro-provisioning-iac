# Raw credentials provided for setup — never commit
creds/

# Project-local AWS credentials (contains secret access key)
.aws/credentials

# mise local/secret overrides
mise.local.toml
.mise.local.toml

# Per-run / per-account settings sourced by mise. The template (.env.example)
# stays tracked; the real .env is local-only.
.env
!.env.example

# Python project virtualenv (managed by mise/uv; recreated via `mise install`)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# OpenTofu/Terraform local working dir (provider plugin cache; recreated by init)
.terraform/

# Git worktrees for AI-assisted / parallel development live here. The worktree
# directories are backed by the shared .git store and must never be committed.
.worktrees/

# Foundation IdC service local-only backend config. The backend.hcl holds the
# per-account state config; the tracked backend.hcl.example stays tracked.
foundation/terraform/backend.hcl

# Credential Claim Service local-only artifacts. The audit CSVs contain claimed
# emails (PII) and the backend.hcl holds the per-account state config; the
# tracked backend.hcl.example stays tracked.
claim-service/output/
claim-service/terraform/backend.hcl

# Generated Lambda deployment package (archive_file output in lambda.tf);
# rebuilt from the handler + frontend on every plan/apply.
claim-service/terraform/build/

# Governance stack local-only backend config.
governance/terraform/backend.hcl

# Per-stack tfvars hold local inputs (and sometimes secrets) and must never be
# committed; the tracked *.tfvars.example templates stay in git. These rules
# apply to every stack (backend, subscription, foundation, claim-service,
# governance). Keep the example negation LAST so it always wins.
**/terraform.tfvars
**/*.auto.tfvars
!**/terraform.tfvars.example
