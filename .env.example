# ---------------------------------------------------------------------------
# Per-run / per-account settings — the ONE place to change these values.
#
#   cp .env.example .env    # then edit .env (git-ignored)
#
# mise sources this file (see mise.toml `_.file = ".env"`) and exports the
# variables below. Changing a value here changes it everywhere: the AWS CLI,
# the SDKs, OpenTofu (which inherits AWS_REGION / AWS_PROFILE), and the scripts.
# No committed file needs editing to point the repo at a different account/region.
# ---------------------------------------------------------------------------

# AWS CLI/SDK profile (defined in .aws/config). Scopes which credentials are used.
# Which account this must point at depends on the instance mode you run the
# foundation + subscription stacks in:
#   - organization mode (default): a MANAGEMENT-account profile — the account
#     that owns AWS Organizations and the organization IAM Identity Center
#     instance. governance/ and governance-shared/ ALWAYS require this (they are
#     management-only).
#   - account mode (subscription instance_mode = "account"): the CHILD/member
#     account's profile — foundation + subscription then adopt/write that
#     account's OWN IdC account instance.
# CAUTION: running with a management-account profile while intending account
# mode silently targets the ORGANIZATION instance — double-check the profile.
# Set during Phase 0 (toolchain + AWS auth) — see the root README.
AWS_PROFILE=kiro-mgmt

# Workshop namespace. A short slug (1-63 lowercase alphanumerics and hyphens,
# starting/ending alphanumeric, no consecutive hyphens, e.g. kiro-2025-10-10)
# that keys this workshop's Phase 3 provisioning and Phase 4 claim service —
# its remote state and resources — so independent workshops never collide.
# Required by the mutating tasks `provision`, `teardown-tofu`,
# and the claim-service `claim-deploy` / `claim-seed` / `claim-audit` /
# `claim-destroy`; they fail closed if it is unset. Change it per workshop.
WORKSHOP_ID=change-me-per-workshop

# Kiro sign-in region. Kiro supports only us-east-1 today; this is the region a
# participant enters during Kiro sign-in. It does NOT affect where AWS resources
# are created.
KIRO_REGION=us-east-1

# Region the IdC instance you target lives in, and in which ALL AWS resources
# are provisioned (identities in that instance, S3, Lambda). In organization
# mode this is the management-account IdC ORGANIZATION instance's region; in
# account mode (subscription instance_mode = "account") it is the CHILD account's
# IdC ACCOUNT instance's region. AWS_REGION tracks this value, so the AWS
# CLI/SDKs/OpenTofu all target it.
IDC_REGION=ap-southeast-1

# AWS_REGION tracks IDC_REGION — set IDC_REGION above, not this. AWS_DEFAULT_REGION
# is derived from AWS_REGION automatically by mise.
AWS_REGION=${IDC_REGION}

# ---------------------------------------------------------------------------
# claim-service only (used in Phase 4) — the shared gate secret participants
# submit with a claim.
# The Function URL is public (authorization NONE); this code + the per-IP cap
# are the access control. Required by `mise run claim-deploy`; the deploy task
# exports it as TF_VAR_workshop_code so it is never written to a tracked file.
# Pick a fresh value per workshop and do NOT share it before the event.
# ---------------------------------------------------------------------------
WORKSHOP_CODE=change-me-per-workshop
