# Extra, scripts-only run settings for a provisioning project.
# Copy to settings.env (git-ignored) and source it, or just use these as a
# reference for the values you pass to the scripts.
#
#   cp settings.example.env settings.env && edit
#
# NOTE: these are convenience values for the scripts/runbook — the OpenTofu
# config is driven by terraform.tfvars, not by this file.

# AWS targeting (AWS_PROFILE / AWS_REGION) lives in the repo-root `.env`, which
# mise sources. Set the profile and region THERE, not here, so there is one
# source of truth. The values below are the extra, scripts-only knobs.

# Kiro tier for this batch (must match terraform.tfvars kiro_tier)
KIRO_TIER=PRO

# Where the credentials Markdown is written (git-ignored)
CREDENTIALS_OUT=../output/credentials.md

# The IdC/Kiro access-portal sign-in URL. UNKNOWN until you enable Kiro in the
# console (RUNBOOK.md step 3). Fill it in, then it flows into credentials.md.
SIGN_IN_URL=

# Optional CSV of one-time passwords collected from the console (username,otp)
OTP_CSV=../output/otps.csv
