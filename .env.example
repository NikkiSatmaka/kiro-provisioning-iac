# ---------------------------------------------------------------------------
# Per-run / per-account settings — the ONE place to change these values.
#
#   cp .env.example .env    # then edit .env (git-ignored)
#
# mise sources this file (see mise.toml `_.file = ".env"`) and exports the
# variables below. Changing a value here changes it everywhere: the AWS CLI,
# the SDKs, OpenTofu (which inherits AWS_REGION / AWS_PROFILE), and the scripts.
# No committed file needs editing to point the repo at a different account/region.
# ---------------------------------------------------------------------------

# AWS CLI/SDK profile (defined in .aws/config). Scopes which credentials are used.
AWS_PROFILE=kiro-provisioning

# Region for everything: the IdC account instance, Kiro, OpenTofu, and sign-in.
# Must be a region Kiro supports for IdC. AWS_DEFAULT_REGION is derived from this
# automatically by mise — set it only here.
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# claim-service only — the shared gate secret participants submit with a claim.
# The Function URL is public (authorization NONE); this code + the per-IP cap
# are the access control. Required by `mise run claim-deploy`; the deploy task
# exports it as TF_VAR_workshop_code so it is never written to a tracked file.
# Pick a fresh value per workshop and do NOT share it before the event.
# ---------------------------------------------------------------------------
WORKSHOP_CODE=change-me-per-workshop
